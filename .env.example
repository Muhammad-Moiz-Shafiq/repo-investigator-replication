# Copy this file to .env and fill in real values. Never commit .env itself.

# --- GitHub ---
# Fine-grained PAT, "Public Repositories (read-only)" access — used by the ingestion
# layer to read commits/PRs/issues/CI runs from any public repo.
GITHUB_PAT=

# --- Supabase (Postgres + raw storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=repo-investigator-raw
# Postgres connection string, from Supabase Project Settings -> Database -> Connection string
DATABASE_URL=
# Read-only role, for the Variant B sandbox only -- SELECT-only, no write access
# (created via scripts/create_sandbox_role.sql, see agent_methodology_log.md for why
# a scoped credential is the sandbox's real security boundary, not network isolation)
SANDBOX_DATABASE_URL=

# --- Agent LLM ---
# Original three models for the Variant A/B comparison study, plus two added
# later (2026-09-25) to check whether findings replicate on other providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL_WEAK_1=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_WEAK_2=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_STRONG=google/gemini-2.5-pro
OPENROUTER_MODEL_CLAUDE=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_GPT=openai/gpt-5-mini
OPENROUTER_MODEL_DEEPSEEK_V32=deepseek/deepseek-v3.2
# Google AI Studio key -- not currently used 
GOOGLE_AI_API_KEY=

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Docker sandbox ---
SANDBOX_IMAGE_NAME=repo-investigator-sandbox:latest
